{
  "name": "pco-protocol",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "dev:landing": "turbo dev --filter=landing",
    "dev:local": "turbo run dev:local",
    "dev:local:chain": "turbo run dev:local --filter=@0xslots/chain",
    "dev:vitrine": "turbo dev --filter=vitrine",
    "dev:mcp": "turbo dev --filter=@0xslots/mcp",
    "dev:nft": "turbo dev --filter=nft",
    "dev:all": "turbo dev --filter=landing --filter=@0xslots/mcp",
    "build:landing": "turbo build --filter=landing",
    "build:vitrine": "turbo build --filter=vitrine",
    "build:docs": "turbo build --filter=docs",
    "start:landing": "turbo start --filter=landing",
    "start:docs": "turbo start --filter=docs",
    "dev:api": "turbo dev --filter=api",
    "build:api": "turbo build --filter=api",
    "build:ponder": "turbo build --filter=@0xslots/ponder",
    "start:ponder": "pnpm --filter @0xslots/ponder start",
    "serve:ponder": "pnpm --filter @0xslots/ponder exec ponder serve --schema ${DATABASE_SCHEMA:-public}",
    "start:api": "turbo start --filter=api",
    "lint": "turbo lint",
    "check": "biome check .",
    "check:fix": "biome check --fix .",
    "format": "biome format --fix .",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "turbo build --filter=@0xslots/contracts --filter=@0xslots/sdk && changeset publish"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.14",
    "@changesets/cli": "^2.31.0",
    "turbo": "^2.9.14"
  },
  "packageManager": "pnpm@10.33.0",
  "pnpm": {
    "overrides": {
      "wagmi": "$wagmi",
      "@wagmi/core": "$@wagmi/core",
      "viem": "$viem",
      "react": "$react",
      "react-dom": "$react-dom",
      "@tanstack/react-query": "$@tanstack/react-query",
      "graphql-request": "$graphql-request",
      "graphql": "$graphql",
      "d3-path": "3.1.0"
    },
    "onlyBuiltDependencies": [
      "esbuild",
      "es5-ext",
      "vue-demi"
    ]
  },
  "dependencies": {
    "wagmi": "3.5.0",
    "@wagmi/core": "3.4.0",
    "viem": "2.50.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "@tanstack/react-query": "5.90.21",
    "graphql-request": "7.4.0",
    "graphql": "16.11.0",
    "@0xslots/sdk": "workspace:*"
  }
}
