{
  "name": "@0xslots/chain",
  "version": "0.0.0",
  "private": true,
  "description": "Foundry project. Carries no JS dependencies \u2014 this manifest exists so the local anvil chain is a workspace member turbo can schedule alongside the indexer and the app.",
  "scripts": {
    "dev:local": "./scripts/dev-chain.sh",
    "anvil": "anvil --block-time 2 --gas-limit 2000000000",
    "deploy:local": "forge script script/protocol/DeployProtocol.s.sol:DeployProtocol --broadcast --rpc-url http://127.0.0.1:8545 --private-key 0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80",
    "seed:local": "forge script script/slots/SeedSlots.s.sol:SeedSlots --broadcast --rpc-url http://127.0.0.1:8545 --private-key 0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80 --sig \"run(address)\" $(python3 -c \"import json;print(json.load(open('deployments/31337/SlotFactory.json'))['address'])\")",
    "reset:local": "pnpm deploy:local && pnpm seed:local"
  }
}
