# Base URL for the adland API (ad uploads, analytics, IPFS pinning).
# Published @adland/data resolves this to http://localhost:3069 in development,
# but that port used to be served by this repo's apps/api — those routes
# (/ipfs/upload, /analytics/*) now live in the separate adland repo.
# Set this to https://api.adland.space, or to a locally-running adland api on :3069.
NEXT_PUBLIC_ADLAND_API_URL=

# Alchemy API key used for RPC access.
NEXT_PUBLIC_ALCHEMY_API_KEY=

# 0xSplits API key.
NEXT_PUBLIC_0xSPLITS_API_KEY=

# Subgraph API key (thegraph.com gateway).
NEXT_PUBLIC_SUBGRAPH_API_KEY=

# Public URL of this app. Defaults to https://app.0xslots.org if unset.
NEXT_PUBLIC_APP_URL=

# Set to "true" to use the ngrok tunnel URL instead of NEXT_PUBLIC_APP_URL.
NEXT_PUBLIC_USE_TUNNEL=

# ── Subgraph endpoint overrides (development) ───────────────────────────────
# Unset, the SDK reads the decentralized network via gateway.thegraph.com,
# which only serves a deployment once an INDEXER has allocated to it. A newly
# published version answers `subgraph not found: no allocations` until then.
#
# Subgraph Studio serves a deployment as soon as it has indexed, with no
# allocation involved — so point here to exercise a mapping change before the
# network catches up. Rate-limited; a local tool, not something to ship.
#
# `version/latest` follows whatever was last deployed to Studio, so it moves
# under you on each deploy. Slugs come from packages/subgraph/config/*.json
# (`studioName`) and are not symmetrical — note the extra hyphen on sepolia.
# Set either one alone; the other chain falls back to the gateway.
# NEXT_PUBLIC_SUBGRAPH_URL_BASE=https://api.studio.thegraph.com/query/958/0-xslots-base/version/latest
# NEXT_PUBLIC_SUBGRAPH_URL_BASE_SEPOLIA=https://api.studio.thegraph.com/query/958/0-x-slots-base-sepolia/version/latest
