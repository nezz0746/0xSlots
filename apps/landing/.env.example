# Base URL for the adland API (ad uploads, analytics, IPFS pinning).
# Published @adland/data resolves this to http://localhost:3069 in development,
# but that port used to be served by this repo's apps/api — those routes
# (/ipfs/upload, /analytics/*) now live in the separate adland repo.
# Set this to https://api.adland.space, or to a locally-running adland api on :3069.
NEXT_PUBLIC_ADLAND_API_URL=

# Alchemy API key used for RPC access.
NEXT_PUBLIC_ALCHEMY_API_KEY=

# 0xSplits API key.
NEXT_PUBLIC_0xSPLITS_API_KEY=

# Subgraph API key (thegraph.com gateway).
NEXT_PUBLIC_SUBGRAPH_API_KEY=

# Public URL of this app. Defaults to https://app.0xslots.org if unset.
NEXT_PUBLIC_APP_URL=

# Set to "true" to use the ngrok tunnel URL instead of NEXT_PUBLIC_APP_URL.
NEXT_PUBLIC_USE_TUNNEL=

# ── Subgraph endpoint (development) ─────────────────────────────────────────
# There is no env var for this any more. The Studio endpoints live in
# @0xslots/sdk (STUDIO_SUBGRAPH_URLS) and are selected at runtime from the
# "Dev subgraph" switch at the bottom of the sidebar, persisted per browser.
#
# That works on a deployed build, which is where you actually need it — a
# build-time variable cannot be flipped on a preview deployment.
