{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        ".next/**",
        "!.next/cache/**",
        "!.next/dev/**",
        "out/**",
        "dist/**"
      ],
      "passThroughEnv": [
        "ALCHEMY_KEY",
        "CHAIN_ID"
      ]
    },
    "dev": {
      "dependsOn": [
        "^build"
      ],
      "cache": false,
      "persistent": true
    },
    "start": {
      "dependsOn": [
        "^build"
      ],
      "cache": false,
      "persistent": true,
      "passThroughEnv": [
        "ALCHEMY_KEY",
        "CHAIN_ID"
      ]
    },
    "lint": {},
    "@0xslots/chain#dev:local": {
      "cache": false,
      "persistent": true,
      "with": [
        "@0xslots/ponder#dev:index",
        "landing#dev"
      ]
    },
    "@0xslots/ponder#dev:index": {
      "cache": false,
      "persistent": true
    }
  }
}
