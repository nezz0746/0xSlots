{
  "name": "@0xslots/contracts",
  "version": "0.22.0",
  "description": "Contract ABIs and addresses for 0xSlots protocol",
  "author": "Nezz",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./slots": {
      "types": "./dist/slots.d.ts",
      "import": "./dist/slots.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "codegen": "wagmi generate",
    "codegen:check": "wagmi generate && git diff --exit-code -- src/generated.ts",
    "clean": "rm -rf dist",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm run build"
  },
  "devDependencies": {
    "@types/node": "^20.10.8",
    "@wagmi/cli": "^2.10.0",
    "tsup": "^8.0.0",
    "tsx": "^4.7.3",
    "typescript": "^5.4.4"
  },
  "dependencies": {
    "viem": "2.50.4"
  }
}
