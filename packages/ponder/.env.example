# Coinbase Developer Platform key — used for base-sepolia and base mainnet as
# https://api.developer.coinbase.com/rpc/v1/<network>/<key>. This is CDP's
# *client* key (the one that rides in the URL). When set it REPLACES Alchemy
# rather than joining it; the public tier still sits underneath.
# Ethereum Sepolia has no CDP path here, so it falls through to Alchemy even
# when this is set.
# Get one at https://portal.cdp.coinbase.com/
COINBASE_API_KEY=

# Alchemy API key — the fallback paid provider, used when COINBASE_API_KEY is
# empty. (NOT https://sepolia.base.org — its eth_getLogs is broken for some
# contracts.) Get a free key at https://dashboard.alchemy.com/
ALCHEMY_API_KEY=

# Optional: add the free public endpoints as a cheap tier alongside Alchemy.
# Safe to leave on — ponder tracks each endpoint separately, so one that refuses
# a query costs a retry rather than stalling the sync. Not a substitute for the
# key: base-sepolia and sepolia have exactly one public member each that serves
# this indexer's multi-address eth_getLogs. See the measurements in
# ponder.config.ts.
PONDER_PUBLIC_RPCS=1

# Optional per-chain overrides. A complete URL (or a comma-separated list) is
# the whole answer for that chain — nothing else is added to its pool.
# PONDER_RPC_URL_BASE=
# PONDER_RPC_URL_BASE_SEPOLIA=
# PONDER_RPC_URL_SEPOLIA=

# Optional: Postgres for production. If omitted, Ponder uses local SQLite (.ponder/).
# Format: postgresql://user:password@host:5432/dbname
DATABASE_URL=

# Port for the GraphQL/HTTP server (default 42069)
PORT=42069
